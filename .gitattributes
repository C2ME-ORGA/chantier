# Normalisation des fichiers texte
* text=auto eol=lf

# Détection du langage pour les diffs Git
*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

# Fichiers binaires
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.pdf binary
*.zip binary

# Exclusion des fichiers lors de git archive
CHANGELOG.md export-ignore
README.md export-ignore
